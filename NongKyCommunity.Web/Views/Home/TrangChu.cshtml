@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero"><div class="hero__content"><p class="eyebrow">Cộng đồng kỹ thuật canh tác</p><h1>Kỹ Thuật<br />Nhà Nông</h1><p>Chia sẻ kiến thức, kỹ thuật canh tác và kinh nghiệm sản xuất.</p><div class="actions"><a class="button primary" asp-controller="Posts" asp-action="Index">Khám phá bài viết</a><a class="button light" asp-controller="Posts" asp-action="Create">Chia sẻ kinh nghiệm</a></div></div></section>
<section class="section"><p class="eyebrow">Khám phá</p><h2>Danh mục nổi bật</h2><div class="categories">@foreach(var item in new[]{(Name:"🌱 Trồng trọt",Slug:"trong-trot"),(Name:"🐄 Chăn nuôi",Slug:"chan-nuoi"),(Name:"🪲 Sâu bệnh",Slug:"sau-benh"),(Name:"💧 Tưới tiêu",Slug:"tuoi-tieu"),(Name:"🚜 Máy móc",Slug:"may-moc"),(Name:"💡 Kinh nghiệm nhà nông",Slug:"kinh-nghiem-nha-nong")}){<a asp-controller="Posts" asp-action="Index" asp-route-category="@item.Slug">@item.Name <span>→</span></a>}</div></section>
<section class="section posts-preview"><p class="eyebrow">Từ cộng đồng</p><h2>Bài viết nổi bật</h2><div class="preview-grid"><article><span>Trồng trọt</span><h3>Kinh nghiệm chăm sóc cây trồng theo mùa</h3><p>Chia sẻ kiến thức thực tế, dễ áp dụng cho ruộng vườn.</p><a asp-controller="Posts" asp-action="Index">Đọc bài viết →</a></article><article><span>Kinh nghiệm</span><h3>Canh tác hiệu quả hơn mỗi ngày</h3><p>Cùng học hỏi từ cộng đồng nhà nông.</p><a asp-controller="Posts" asp-action="Index">Xem thêm →</a></article><article><span>Tưới tiêu</span><h3>Tiết kiệm nước cho mùa vụ</h3><p>Những gợi ý đơn giản và thiết thực.</p><a asp-controller="Posts" asp-action="Index">Xem thêm →</a></article></div></section>
<section class="section latest"><p class="eyebrow">Cập nhật mới</p><h2>Bài viết mới nhất</h2><p>Khám phá các kinh nghiệm, kỹ thuật và câu chuyện từ cộng đồng.</p><a class="button primary" asp-controller="Posts" asp-action="Index">Xem tất cả bài viết</a></section>
<section class="cta"><div><p class="eyebrow">Cộng đồng nhà nông</p><h2>Bạn có kinh nghiệm sản xuất muốn chia sẻ?</h2><p>Tham gia cộng đồng Kỹ Thuật Nhà Nông ngay hôm nay.</p></div><a class="button primary" asp-controller="Posts" asp-action="Create">Đăng bài ngay</a></section>
