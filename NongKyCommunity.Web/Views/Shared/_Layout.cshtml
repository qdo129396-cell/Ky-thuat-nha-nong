<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/bieu-tuong-nha-nong.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/bieu-tuong-nha-nong.png" asp-append-version="true" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Kỹ Thuật Nhà Nông</title>
    <script>
        (function () {
            try {
                var preference = localStorage.getItem("ky-thuat-nha-nong-theme") || "system";
                var resolved = preference === "system" ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : preference;
                document.documentElement.dataset.theme = resolved;
                document.documentElement.dataset.themePreference = preference;
            } catch (_) { document.documentElement.dataset.theme = "light"; document.documentElement.dataset.themePreference = "system"; }
        }());
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/giao-dien.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/quan-tri-va-tuong-tac.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/thong-bao-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bao-cao.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/can-chinh-dang-nhap.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tep-da-phuong-tien.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tuong-tac-doc.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/giao-dien-chu-de.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="shell">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Kỹ Thuật Nhà Nông</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav main-navigation">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Posts" asp-action="Index">Bài viết</a>
                        </li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Posts" asp-action="Index">Danh mục</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Giới thiệu</a></li>
                    </ul>
                    <ul class="navbar-nav auth-navigation ms-lg-auto">
                        <li class="nav-item theme-control">
                            <details>
                                <summary aria-label="Chọn giao diện" title="Chọn giao diện"><span class="theme-current-icon" aria-hidden="true">◐</span><span class="theme-current-label">Theo hệ thống</span></summary>
                                <div class="theme-options" role="group" aria-label="Chọn giao diện">
                                    <button type="button" data-theme-choice="light"><span aria-hidden="true">☀</span> Sáng</button>
                                    <button type="button" data-theme-choice="dark"><span aria-hidden="true">☾</span> Tối</button>
                                    <button type="button" data-theme-choice="system"><span aria-hidden="true">▣</span> Theo hệ thống</button>
                                </div>
                            </details>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><span class="nav-link">Xin chào, @User.Identity.Name</span></li>
                            @if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Quản trị</a></li> }
                            <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-link text-dark border-0 bg-transparent">Đăng xuất</button></form></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                            <li class="auth-separator" aria-hidden="true">/</li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="@(ViewData["CommunityFullWidth"] as bool? == true ? "community-host" : "shell page-shell")">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="shell footer-grid"><div><strong>Kỹ Thuật Nhà Nông</strong><p>Chia sẻ tri thức và kinh nghiệm sản xuất bền vững.</p></div><div><strong>Khám phá</strong><a asp-controller="Posts" asp-action="Index">Bài viết</a><a asp-controller="Posts" asp-action="Create">Đăng bài</a></div><div><strong>Liên hệ</strong><p>admin@kythuatnhanong.vn</p></div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/giao-dien.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
