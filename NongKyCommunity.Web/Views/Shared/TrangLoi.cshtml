@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<h1 class="text-danger">Đã xảy ra lỗi.</h1>
<h2 class="text-danger">Không thể xử lý yêu cầu của bạn. Vui lòng thử lại.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Vui lòng quay lại sau hoặc liên hệ quản trị viên nếu sự cố tiếp diễn.</p>
