@model NongKyCommunity.Web.Models.AppUser?
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var displayName = Model?.FullName ?? "Nhà nông";
}
<aside class="community-left">
    <div class="side-profile">
        @if (!string.IsNullOrWhiteSpace(Model?.AvatarUrl))
        {
            <img class="avatar avatar-lg avatar-image" src="@Model.AvatarUrl" alt="Ảnh đại diện @displayName" />
        }
        else
        {
            <span class="avatar avatar-lg">@displayName[..1].ToUpper()</span>
        }
        <strong>@displayName</strong>
        <small>Thành viên cộng đồng</small>
    </div>
    <nav>
        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
        <a class="@(controller == "Posts" && action is "Index" or "Details" ? "active" : "")" asp-controller="Posts" asp-action="Index">Bài viết</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="@(controller == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="MyProfile">Hồ sơ của tôi</a>
        }
        <a class="@(action == "Create" ? "active" : "")" asp-controller="Posts" asp-action="Create">Viết bài</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index">Quản trị</a>
        }
    </nav>
</aside>
