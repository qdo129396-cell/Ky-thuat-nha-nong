@model NongKyCommunity.Web.Models.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<section class="auth-page"><div class="auth-shell"><aside class="auth-visual"><div class="auth-overlay"><p class="auth-badge">CỘNG ĐỒNG NÔNG NGHIỆP</p><h1>Kiến thức thực tế<br />cho mỗi mùa vụ</h1><p>Chia sẻ kỹ thuật canh tác, kinh nghiệm sản xuất và kết nối cùng cộng đồng nhà nông.</p><ul><li>🌱 Chia sẻ kinh nghiệm thực tế</li><li>🌾 Học hỏi kỹ thuật canh tác</li><li>🤝 Kết nối cộng đồng nhà nông</li></ul></div></aside><div class="auth-content"><div class="auth-card"><p class="auth-kicker">KỸ THUẬT NHÀ NÔNG</p><h2>Đăng nhập</h2><p class="auth-subtitle">Chào mừng bạn trở lại với Kỹ Thuật Nhà Nông.</p><form asp-action="Login" method="post" class="auth-form"><div asp-validation-summary="ModelOnly" class="auth-alert"></div><div class="auth-field"><label asp-for="Email">Email</label><input asp-for="Email" placeholder="Nhập địa chỉ email" autocomplete="email" /><span asp-validation-for="Email"></span></div><div class="auth-field"><label asp-for="Password">Mật khẩu</label><div class="auth-password"><input asp-for="Password" placeholder="Nhập mật khẩu" autocomplete="current-password" /><button type="button" class="toggle-password" aria-label="Hiện mật khẩu">👁</button></div><span asp-validation-for="Password"></span></div><button class="auth-submit">Đăng nhập</button></form><p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p></div></div></div></section>
@section Scripts { <partial name="_KiemTraDuLieuPartial" /> }
