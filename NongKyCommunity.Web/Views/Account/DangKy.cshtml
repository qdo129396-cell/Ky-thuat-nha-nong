@model NongKyCommunity.Web.Models.RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; }
<section class="auth-page"><div class="auth-shell"><aside class="auth-visual"><div class="auth-overlay"><p class="auth-badge">CỘNG ĐỒNG NÔNG NGHIỆP</p><h1>Tham gia cộng đồng<br />Kỹ Thuật Nhà Nông</h1><p>Chia sẻ kinh nghiệm, kết nối với những người cùng quan tâm đến nông nghiệp và xây dựng hồ sơ của bạn.</p></div></aside><div class="auth-content"><div class="auth-card"><p class="auth-kicker">KỸ THUẬT NHÀ NÔNG</p><h2>Tạo tài khoản</h2><p class="auth-subtitle">Tham gia cộng đồng và bắt đầu chia sẻ kinh nghiệm của bạn.</p><form asp-action="Register" method="post" class="auth-form"><div asp-validation-summary="ModelOnly" class="auth-alert"></div><div class="auth-field"><label asp-for="FullName">Tên hiển thị</label><input asp-for="FullName" placeholder="Nhập tên hiển thị" autocomplete="name" /><span asp-validation-for="FullName"></span></div><div class="auth-field"><label asp-for="Email">Email</label><input asp-for="Email" placeholder="Nhập địa chỉ email" autocomplete="email" /><span asp-validation-for="Email"></span></div><div class="auth-field"><label asp-for="Password">Mật khẩu</label><div class="auth-password"><input asp-for="Password" placeholder="Tạo mật khẩu" autocomplete="new-password" /><button type="button" class="toggle-password" aria-label="Hiện mật khẩu">👁</button></div><small>Mật khẩu phải có ít nhất 8 ký tự.</small><span asp-validation-for="Password"></span></div><button class="auth-submit">Đăng ký</button></form><p class="auth-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></div></div></div></section>
@section Scripts { <partial name="_KiemTraDuLieuPartial" /> }
