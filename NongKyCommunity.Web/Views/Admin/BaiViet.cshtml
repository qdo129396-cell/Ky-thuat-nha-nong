@model IEnumerable<NongKyCommunity.Web.Models.Post>
@{ ViewData["Title"] = "Quản lý bài viết"; var categories = ViewBag.Categories as IEnumerable<NongKyCommunity.Web.Models.Category> ?? []; }
<section class="admin-page"><h1>Quản lý bài viết</h1><p>Admin chỉ có thể ẩn hoặc xóa bài của người dùng; không thể chỉnh sửa nội dung bài viết.</p>
    <nav class="admin-nav"><a asp-action="Index">Tổng quan</a><a asp-action="Users">Người dùng</a><a asp-action="Comments">Bình luận</a><a asp-action="Reports">Báo cáo</a><a asp-action="Categories">Danh mục</a><a asp-action="Crops">Loại cây</a></nav>
    <form method="get" class="admin-search"><input name="search" value="@ViewBag.Search" placeholder="Tìm bài viết" /><select name="categoryId"><option value="">Tất cả danh mục</option>@foreach (var category in categories) { <option value="@category.Id" selected="@(ViewBag.CategoryId == category.Id)">@category.Name</option> }</select><button>Lọc</button></form>
    <table class="admin-table"><thead><tr><th>Tiêu đề</th><th>Tác giả</th><th>Danh mục</th><th>Trạng thái</th><th>Kiểm duyệt</th></tr></thead><tbody>@foreach (var post in Model) { <tr><td>@post.Title</td><td>@post.Author.FullName</td><td>@post.Category.Name</td><td>@(post.IsPublished ? "Đã xuất bản" : "Đã ẩn / nháp")</td><td>@if (post.IsPublished) { <form asp-action="HidePost" method="post"><input type="hidden" name="id" value="@post.Id" /><button>Ẩn bài</button></form> }<form asp-action="DeletePost" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa bài viết này?');"><input type="hidden" name="id" value="@post.Id" /><button class="admin-danger">Xóa</button></form></td></tr> }</tbody></table>
</section>
