@model NongKyCommunity.Web.Models.Post
@{ Layout = "_BoCucCongDong"; ViewData["Title"] = "Chỉnh sửa bài viết"; var categories = ViewBag.Categories as IEnumerable<NongKyCommunity.Web.Models.Category> ?? []; }
<section class="community-form"><h1>Chỉnh sửa bài viết</h1><form asp-action="Edit" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="@Model.Id" /><div asp-validation-summary="ModelOnly" class="form-error"></div><label for="title">Tiêu đề</label><input id="title" name="title" value="@Model.Title" required /><label for="excerpt">Mô tả ngắn</label><textarea id="excerpt" name="excerpt">@Model.Excerpt</textarea><label for="categoryId">Danh mục</label><select id="categoryId" name="categoryId">@foreach (var category in categories) { <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option> }</select><label for="content">Nội dung</label><textarea id="content" name="content" rows="12" required>@Model.Content</textarea><label for="image">Thay ảnh bài viết</label><input id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp" />@if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img class="edit-post-image" src="@Model.ImageUrl" alt="Ảnh hiện tại" /> }<label for="video">Thay video bài viết</label><input id="video" name="video" type="file" accept="video/mp4,video/webm" />@if (!string.IsNullOrWhiteSpace(Model.VideoUrl)) { <video class="post-video" controls src="@Model.VideoUrl"></video> }<label class="publish-choice"><input type="checkbox" name="isPublished" value="true" checked="@Model.IsPublished" /><span><strong>Xuất bản ngay</strong><small>Bỏ chọn để lưu lại dưới dạng bản nháp.</small></span></label><button class="button primary">Lưu thay đổi</button></form></section>
