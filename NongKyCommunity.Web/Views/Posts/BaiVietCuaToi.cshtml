@model IEnumerable<NongKyCommunity.Web.Models.Post>
@{ Layout = "_BoCucCongDong"; ViewData["Title"] = "Bài viết của tôi"; var currentPage = (int)(ViewBag.Page ?? 1); var totalPages = (int)(ViewBag.TotalPages ?? 1); }

<header class="community-heading"><div><p class="eyebrow">KHU VỰC CÁ NHÂN</p><h1>Bài viết của tôi</h1><p>Quản lý bài đã xuất bản và các bản nháp của bạn.</p></div><a class="button primary" asp-action="Create">+ Viết bài</a></header>
@if (!Model.Any()) { <div class="feed-empty"><h2>Bạn chưa có bài viết nào</h2><p>Hãy chia sẻ một kinh nghiệm thực tế để bắt đầu xây dựng cộng đồng.</p><a class="button primary" asp-action="Create">Viết bài đầu tiên</a></div> }
else { foreach (var post in Model) { <article class="social-post"><header class="social-post-header"><span class="avatar">@post.Author.FullName[..1].ToUpper()</span><div><strong>@post.Author.FullName</strong><small>@post.CreatedAt.ToString("dd/MM/yyyy") · <em>@post.Category.Name</em></small></div></header><div class="social-post-body"><h2><a asp-action="Details" asp-route-slug="@post.Slug">@post.Title</a></h2><p>@post.Excerpt</p></div>@if (!string.IsNullOrWhiteSpace(post.ImageUrl)) { <img class="social-post-media" src="@post.ImageUrl" alt="@post.Title" /> }<footer class="my-post-actions"><span class="@(post.IsPublished ? "post-status published" : "post-status draft")">@(post.IsPublished ? "Đã xuất bản" : "Bản nháp")</span>@if (!post.IsPublished) { <form asp-action="Publish" method="post"><input type="hidden" name="id" value="@post.Id" /><button class="button primary">Xuất bản ngay</button></form> }<a asp-action="Edit" asp-route-id="@post.Id">Chỉnh sửa</a><form asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa bài viết này?');"><input type="hidden" name="id" value="@post.Id" /><button class="danger-link">Xóa</button></form></footer></article> } if (totalPages > 1) { <nav class="feed-pagination" aria-label="Phân trang bài viết của tôi"><a class="@(currentPage == 1 ? "disabled" : "")" asp-action="MyPosts" asp-route-page="@(currentPage - 1)">← Trước</a><b>@currentPage</b><a class="@(currentPage == totalPages ? "disabled" : "")" asp-action="MyPosts" asp-route-page="@(currentPage + 1)">Sau →</a></nav> } }
